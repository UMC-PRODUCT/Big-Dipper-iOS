//
//  Shared.xcconfig
//  UMCApp
//
//  앱 타겟에 주입되는 공통 빌드 설정입니다. (커밋됨 — 비밀 값 없음)
//
//  구성:
//  1. 비밀이 아닌 기본값(환경별 BASE_URL 등)을 여기서 정의합니다.
//  2. 파일 마지막의 `#include?` 로 로컬 `Secrets.xcconfig`(git 미추적)를 선택적으로 포함해,
//     개발자별 실제 키(KAKAO_KEY / TMAP_SECRET_KEY / 실서버 BASE_URL)를 오버라이드합니다.
//  3. `Secrets.xcconfig` 가 없어도(신규 클론) `#include?` 는 에러 없이 넘어가며 아래 기본값이 쓰입니다.
//
//  주의: xcconfig 에서 `//` 는 주석이므로 URL 은 `https:/$()/...` 형태로 escape 합니다.
//        (`$()` 는 빈 치환이라 최종 값에는 영향이 없습니다.)

// MARK: - API Base URL (환경별)

// 빌드 Configuration 에 따라 dev / prod 서버가 자동 선택됩니다.
BASE_URL = https:/$()/dev.api.umc.example.com
BASE_URL[config=Debug] = https:/$()/dev.api.umc.example.com
BASE_URL[config=Release] = https:/$()/api.umc.example.com

// MARK: - 서드파티 키 (기본 빈 값 — 실제 값은 Secrets.xcconfig 에서 주입)

KAKAO_KEY =
TMAP_SECRET_KEY =
GOOGLE_CLIENT_ID =
GOOGLE_REVERSED_CLIENT_ID =

// MARK: - 로컬 시크릿 오버라이드 (git 미추적)

#include? "Secrets.xcconfig"
