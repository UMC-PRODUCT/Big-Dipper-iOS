//
//  Secrets.xcconfig.template
//  UMCApp
//
//  로컬 개발용 시크릿 템플릿입니다. (커밋됨 — 실제 값 없음)
//
//  사용법:
//  1. 같은 폴더에 "Secrets.xcconfig" 이름으로 복사
//       cp Secrets.xcconfig.template Secrets.xcconfig
//  2. 아래 값을 팀 공유 채널에서 받은 실제 값으로 채우기
//  3. `Secrets.xcconfig` 는 .gitignore 에 포함되어 커밋되지 않음
//  4. `cd UMCApp && make generate` 후 빌드
//
//  값들은 Shared.xcconfig 의 기본값을 오버라이드합니다.
//  xcconfig 에서 `//` 는 주석이므로 URL 은 `https:/$()/...` 형태로 escape 합니다.

// 카카오 네이티브 앱 키 (https://developers.kakao.com/)
KAKAO_KEY = YOUR_KAKAO_NATIVE_APP_KEY_HERE

// TMap Geocoding Secret Key
TMAP_SECRET_KEY = YOUR_TMAP_SECRET_KEY_HERE

// API 서버 주소 (환경별 오버라이드)
BASE_URL = https:/$()/api.umc.example.com
BASE_URL[config=Debug] = https:/$()/dev.api.umc.example.com
BASE_URL[config=Release] = https:/$()/api.umc.example.com
